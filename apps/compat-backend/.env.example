# Compat backend config (copy to .env; .env is gitignored)
PORT=8080
SM_COMPAT_BASE_URL=http://localhost:8080
SM_COMPAT_DB=compat.sqlite
# generate: openssl rand -hex 32
SM_COMPAT_AUTH_SECRET=change-me
# console origin(s), comma-separated
SM_COMPAT_TRUSTED_ORIGINS=http://localhost:3939
# Prod only: share the session cookie across subdomains (console + API). Leave EMPTY in local
# dev. Ex.: SM_COMPAT_COOKIE_DOMAIN=.os.avenia.tech (com SM_COMPAT_BASE_URL=https://api.os.avenia.tech)
SM_COMPAT_COOKIE_DOMAIN=
# self-hosted lite supermemory-server (public HTTPS in dev, or http://127.0.0.1:6767 on the VM)
SM_LITE_URL=https://your-lite-host.example
SM_LITE_API_KEY=sm_xxx

# --- MCP (official Worker delegates OAuth here) ---
SM_COMPAT_LOGIN_PAGE=http://localhost:3939/login
SM_MCP_RESOURCE=http://localhost:8788/mcp

# --- Auth: e-mail transport (Resend) — powers magic link, email OTP, password reset ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=Supermemory <login@your-verified-domain.com>

# --- Auth: Google social login (reuses the Drive OAuth client) ---
# Add ${SM_COMPAT_BASE_URL}/api/auth/callback/google to the client's Authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxx

# --- Connector: Granola (meeting notes) ---
# No server credentials needed — each user pastes their own Granola API key (grn_...) in the
# console's Granola connect modal (Settings → Connectors → API keys in the Granola app).
# Ingest the AI summary only (default) or also the full transcript (large/noisy):
SM_GRANOLA_INCLUDE_TRANSCRIPT=false
# Optional API base override (default https://public-api.granola.ai/v1):
# SM_GRANOLA_API_URL=https://public-api.granola.ai/v1

# --- Connectors: periodic auto re-sync ---
# Re-sync every connected connection (Drive + Granola) every N hours. 0 disables it.
SM_RESYNC_INTERVAL_HOURS=4

# --- Company Brain: Slack bot ---
# Create a Slack app (manifest in docs/slack-app.md). Events request URL:
#   ${SM_COMPAT_BASE_URL}/brain/slack/events   (needs SLACK_SIGNING_SECRET)
SLACK_SIGNING_SECRET=
#
# Two ways to connect the bot token:
#  A) OAuth "Add to Slack" flow (multi-workspace): set Client ID/Secret; the xoxb is fetched
#     automatically on install. OAuth redirect URL: ${SM_COMPAT_BASE_URL}/brain/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
#  B) Single workspace, simplest: install the app in your workspace and paste its Bot User
#     OAuth Token (xoxb-…) here — no Client ID/Secret or OAuth needed. (xapp-… is NOT used.)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_ORG_ID=            # optional; else the earliest org in the DB is used
# Passive capture mode: durable (LLM triages + extracts facts) | all (ingest every message) |
# on-demand (only when explicitly triggered with "@bot lembra: ..."). Default: durable.
SLACK_EXTRACTION_MODE=durable
# Optional: where to send the browser back after install (default: first trusted origin).
# SM_SLACK_POST_INSTALL_REDIRECT=https://os.avenia.tech
# Optional: the org's shared brain container tag (default: sm_org_shared).
# SM_BRAIN_CONTAINER_TAG=sm_org_shared
