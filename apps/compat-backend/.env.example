# Compat backend config (copy to .env; .env is gitignored)
PORT=8080
SM_COMPAT_BASE_URL=http://localhost:8080
SM_COMPAT_DB=compat.sqlite
# generate: openssl rand -hex 32
SM_COMPAT_AUTH_SECRET=change-me
# console origin(s), comma-separated
SM_COMPAT_TRUSTED_ORIGINS=http://localhost:3939
# Prod only: share the session cookie across subdomains (console + API). Leave EMPTY in local
# dev. Ex.: SM_COMPAT_COOKIE_DOMAIN=.os.avenia.tech (com SM_COMPAT_BASE_URL=https://api.os.avenia.tech)
SM_COMPAT_COOKIE_DOMAIN=
# self-hosted lite supermemory-server (public HTTPS in dev, or http://127.0.0.1:6767 on the VM)
SM_LITE_URL=https://your-lite-host.example
SM_LITE_API_KEY=sm_xxx

# --- MCP (official Worker delegates OAuth here) ---
SM_COMPAT_LOGIN_PAGE=http://localhost:3939/login
SM_MCP_RESOURCE=http://localhost:8788/mcp

# --- Auth: e-mail transport (Resend) — powers magic link, email OTP, password reset ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=Supermemory <login@your-verified-domain.com>

# --- Auth: Google social login (reuses the Drive OAuth client) ---
# Add ${SM_COMPAT_BASE_URL}/api/auth/callback/google to the client's Authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxx
