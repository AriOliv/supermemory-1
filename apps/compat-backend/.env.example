# Compat backend config (copy to .env; .env is gitignored)
PORT=8080
SM_COMPAT_BASE_URL=http://localhost:8080
SM_COMPAT_DB=compat.sqlite
# generate: openssl rand -hex 32
SM_COMPAT_AUTH_SECRET=change-me
# console origin(s), comma-separated
SM_COMPAT_TRUSTED_ORIGINS=http://localhost:3939
# self-hosted lite supermemory-server (public HTTPS in dev, or http://127.0.0.1:6767 on the VM)
SM_LITE_URL=https://your-lite-host.example
SM_LITE_API_KEY=sm_xxx
